APP_NAME=Plutus
ENVIRONMENT=local

# Postgres connection for the app's own (non-superuser, RLS-subject) role.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/plutus

# Database roles (docs/operations/runbook.md, "Database roles"). Migrations
# run as MIGRATION_DATABASE_URL, the tables' owner (DATABASE_URL if unset);
# each migration run grants APP_DATABASE_ROLE access to new tables. With
# REQUIRE_RLS_ENFORCED=true the API refuses to start if row-level security
# doesn't bind its own connection (a superuser, BYPASSRLS or the owner).
MIGRATION_DATABASE_URL=
APP_DATABASE_ROLE=
REQUIRE_RLS_ENFORCED=false

# Symmetric signing key for access/refresh JWTs. Generate a real random
# value per environment (e.g. `openssl rand -hex 32`) — never reuse this.
JWT_SECRET=change-me-in-every-real-environment-32-bytes-min
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Runs the daily reminders / recurring-bill / recurring-invoice jobs
# in-process (see app/workers/scheduler.py). Set to false to run this
# instance as an API-only replica with no scheduled jobs of its own.
SCHEDULER_ENABLED=true

# Object storage for employee photos (see app/core/storage.py). Any
# S3-compatible provider — Cloudflare R2, AWS S3, Supabase Storage's S3
# endpoint. Leave all four unset for local dev/CI: storage then falls
# back to local disk, signed with OBJECT_STORAGE_SIGNING_SECRET.
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_LOCAL_DIR=./var/object-storage
OBJECT_STORAGE_SIGNING_SECRET=change-me-in-every-real-environment-32-bytes-min
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300

# Days after an employee's final-settlement termination_date before their
# photo is purged (NDPR retention) — an employer-policy default, not a
# statutory figure.
EMPLOYEE_PHOTO_RETENTION_DAYS=30
